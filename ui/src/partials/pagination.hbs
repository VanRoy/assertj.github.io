{{#unless (eq page.attributes.pagination undefined)}}
{{#if (or page.previous page.next)}}
<nav class="pagination" aria-label="Pagination">
  {{#with page.previous}}
  <a class="pagination-link prev" href="{{{relativize ./url}}}">
    <span class="pagination-label">Previous</span>
    <span class="pagination-title">{{{./content}}}</span>
  </a>
  {{/with}}
  {{#with page.next}}
  <a class="pagination-link next" href="{{{relativize ./url}}}">
    <span class="pagination-label">Next</span>
    <span class="pagination-title">{{{./content}}}</span>
  </a>
  {{/with}}
</nav>
{{/if}}
{{/unless}}
